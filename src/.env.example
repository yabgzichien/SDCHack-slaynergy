# PostgreSQL connection. If unset, a local SQLite file is used (.data/jobbery.db).
DATABASE_URL=
# Signs the session cookie. Set a long random string in production.
SESSION_SECRET=
# Shared passcode for the counsellor view. If unset, the published demo passcode "counsellor-demo" works.
COUNSELLOR_PASSCODE=
# Protects the daily data-refresh cron (/api/cron/refresh). Set a long random string in the Vercel project; Vercel sends it
# as "Authorization: Bearer <value>". With no value the cron route refuses every request.
CRON_SECRET=
# AI resume reader, tried in this order. If none is set, only the rule-based scanner runs.
# 1. The LLM gateway: LLM_API_KEY, LLM_BASE_URL and LLM_MODEL below.
# 2. RunPod Serverless vLLM endpoint (needs both).
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# 3. Groq, the last backup.
GROQ_API_KEY=

# LLM gateway, also used by the data-source finder: a model helps only when the plain rules cannot find or read the DOSM release. Off if LLM_API_KEY is empty or DATA_ASSIST=off.
LLM_API_KEY=
LLM_BASE_URL=https://litellm.rapidscreen.io/v1
LLM_MODEL=deepseek-v4.1-flash
# Certificate check (the plan's course steps). It reads a PDF's text with the providers above; a JPG or PNG screenshot needs a model that can see images.
# Set the gateway's vision model here (a RunPod or Groq model must itself support images). Without a working provider, certificates cannot be verified.
LLM_VISION_MODEL=
