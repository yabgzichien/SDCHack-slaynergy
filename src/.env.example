# PostgreSQL connection. If unset, a local SQLite file is used (.data/jobbery.db).
DATABASE_URL=
# Signs the session cookie. Set a long random string in production.
SESSION_SECRET=
# Shared passcode for the counsellor view. If unset, the published demo passcode "counsellor-demo" works.
COUNSELLOR_PASSCODE=
# Protects the daily data-refresh cron (/api/cron/refresh). Set a long random string in the Vercel project; Vercel sends it
# as "Authorization: Bearer <value>". With no value the cron route refuses every request.
CRON_SECRET=
# AI resume reader, tried in this order. If none is set, only the rule-based scanner runs.
# 1. RunPod Serverless vLLM endpoint (needs both).
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# 2. Groq, used as the backup.
GROQ_API_KEY=

# Data-source finder: a model helps only when the plain rules cannot find or read the DOSM release. Off if LLM_API_KEY is empty or DATA_ASSIST=off.
LLM_API_KEY=
LLM_BASE_URL=https://litellm.rapidscreen.io/v1
LLM_MODEL=deepseek-v4.1-flash
