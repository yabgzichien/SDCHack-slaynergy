# Replit configuration for Jobbery. The app lives in the jobbery/ folder.
run = ["sh", "-c", "cd jobbery && npm install && npm run dev -- -p 3000 -H 0.0.0.0"]
modules = ["nodejs-22"]

[deployment]
build = ["sh", "-c", "cd jobbery && npm ci && npm run build"]
run = ["sh", "-c", "cd jobbery && npm run start -- -p 3000 -H 0.0.0.0"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 3000
externalPort = 80
