# Postgres (Replit database). If unset, a local SQLite file is used (.data/jobbery.db).
DATABASE_URL=
# Signs the session cookie. Set a long random string in production.
SESSION_SECRET=
# Shared passcode for the counsellor view. If unset, the published demo passcode "counsellor-demo" works.
COUNSELLOR_PASSCODE=
# Groq API key for the AI resume reader. If unset, only the rule-based scanner runs.
GROQ_API_KEY=
